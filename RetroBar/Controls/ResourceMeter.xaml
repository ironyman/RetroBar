<UserControl x:Class="RetroBar.Controls.ResourceMeter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:RetroBar.Converters"
             xmlns:utilities="clr-namespace:RetroBar.Utilities"
             Focusable="False"
             Width="20"
             Height="20"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <converters:ToolTipPlacementConverter x:Key="toolTipPlacementConverter" />
    </UserControl.Resources>
    <UserControl.ToolTip>
        <ToolTip>
            <ToolTip.Placement>
                <MultiBinding Converter="{StaticResource toolTipPlacementConverter}">
                    <Binding Source="{x:Static utilities:Settings.Instance}" Path="Edge" />
                </MultiBinding>
            </ToolTip.Placement>
            <StackPanel Margin="4" MinWidth="150">
                <TextBlock x:Name="TipTitle" FontWeight="Bold" />
                <TextBlock x:Name="TipDetail" Margin="0,2,0,4" />
                <Canvas x:Name="GraphCanvas" Width="150" Height="50" ClipToBounds="True">
                    <Canvas.Background>
                        <SolidColorBrush Color="Gray" Opacity="0.2" />
                    </Canvas.Background>
                </Canvas>
            </StackPanel>
        </ToolTip>
    </UserControl.ToolTip>
    <Grid Width="20" Height="20">
        <Canvas Width="20" Height="20">
            <Path x:Name="TrackPath" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                <Path.Stroke>
                    <SolidColorBrush Color="Gray" Opacity="0.4" />
                </Path.Stroke>
            </Path>
            <Path x:Name="FillPath" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        </Canvas>
        <TextBlock x:Name="IconText"
                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource ClockForeground}" />
    </Grid>
</UserControl>
